# Скопируйте в .env.local и подставьте значения своего проекта Supabase.
# Ключи берутся в дашборде: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Секрет — только для сервера (Admin API: заведення співробітників зі сторінки
# «Команда»). Ніколи не NEXT_PUBLIC_, ніколи не комітиться разом зі значенням.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Если проект подключён через интеграцию Vercel ↔ Supabase, переменные там называются иначе
# (SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY / SUPABASE_ANON_KEY, SUPABASE_SECRET_KEY) — приложение
# понимает и их, дублировать под своими именами не нужно.
